{
    "name": "baspa/buienradar-php-api",
    "description": "PHP package to provide a fluent syntax for the Buienradar API.",
    "keywords": [
        "buienradar",
        "buienradar-api",
        "weather",
        "weer",
        "rain",
        "forecast",
        "api",
        "php"
    ],
    "homepage": "https://github.com/baspa/buienradar-php-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Baspa",
            "email": "hello@baspa.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.3",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Baspa\\Buienradar\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Baspa\\Buienradar\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
